# ============================================================
# Jarvis Fênix — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre TODAS na Vercel
# (Project → Settings → Environment Variables). Nunca versione .env.local.
# ============================================================

# --- Planilha Jarvis_Fenix (conta de serviço do Google) ---
# E-mail da conta de serviço (algo como jarvis-web@SEU-PROJETO.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Campo "private_key" do JSON da conta de serviço, entre aspas, com os \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SHEET_ID=1krSssMZcSLsD7mmCOOGQp_foJMEJqhAS2t4ExjHZAVE

# --- Login (Auth.js + Google) ---
# Só estes e-mails entram (separados por vírgula)
ALLOWED_EMAILS=
# Gere com: openssl rand -base64 33
AUTH_SECRET=
# Google Cloud → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Notificações (Web Push) ---
# Gere com: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato que vai junto com o push (opcional)
VAPID_SUBJECT=mailto:fenix.hospitalares@gmail.com

# --- Crons (Vercel Cron manda "Authorization: Bearer <CRON_SECRET>") ---
# Gere com: openssl rand -hex 32
CRON_SECRET=

# --- Senhas das contas de e-mail pessoais (AES-256-GCM) ---
# 32 bytes. Gere com: openssl rand -hex 32   (NÃO troque depois: as senhas salvas deixam de abrir)
EMAIL_ENC_KEY=

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave de serviço: SOMENTE no servidor
SUPABASE_SERVICE_ROLE_KEY=

# --- Só para desenvolvimento: dados fictícios e sem login (ignorado em produção) ---
# JARVIS_DEMO=1
